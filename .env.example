# Postgres (container + Kafka Connect)
POSTGRES_PASSWORD=change_me
# Python scripts: migrate, seed, generate
DATABASE_URL=postgresql://feastflow:change_me@localhost:5432/feastflow

# MinIO (user is feastflow, set in docker-compose.yml)
MINIO_ROOT_PASSWORD=change_me

# Landing sink + integration tests
KAFKA_BOOTSTRAP=localhost:9092
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lake
S3_ACCESS_KEY=feastflow
S3_SECRET_KEY=change_me
AWS_REGION=us-east-1
# For AWS S3 instead: unset S3_ENDPOINT_URL, S3_ACCESS_KEY, S3_SECRET_KEY,
# set S3_BUCKET=feastflow-lake-<account-id> and AWS_REGION=ap-south-2.
